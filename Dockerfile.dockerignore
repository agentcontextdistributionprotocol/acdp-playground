# BuildKit reads this (named <dockerfile>.dockerignore) for the playground
# build, whose context is now this repo itself. Patterns are relative to that
# context root. Keep the context small and never ship local venvs, caches, or
# gitignored plans.
**/.git
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/node_modules
**/.DS_Store
plans
.claude
.env
